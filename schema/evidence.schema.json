{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openaisf.org/schema/evidence.schema.json",
  "title": "OpenAISF Evidence Record",
  "description": "One signed observation about one control on one plane over one window. Produced by an adapter at the enforcement point, never assembled by hand.",
  "type": "object",
  "required": [
    "openaisf_evidence",
    "subject",
    "control",
    "plane",
    "window",
    "observations",
    "producer"
  ],
  "additionalProperties": false,
  "properties": {
    "openaisf_evidence": {
      "const": "1.0"
    },
    "subject": {
      "type": "object",
      "required": [
        "system_id"
      ],
      "additionalProperties": false,
      "properties": {
        "system_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "artefact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{8,64}$"
        }
      }
    },
    "control": {
      "type": "string",
      "pattern": "^D(0[1-9]|1[0-9]|20)-(C|X)[0-9]{2}$"
    },
    "plane": {
      "description": "control: the policy IS configured. data: the policy WAS enforced, drawn from live traffic.",
      "enum": [
        "control",
        "data"
      ]
    },
    "window": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "observations": {
      "type": "object",
      "description": "Adapter-specific fields. Three keys are reserved and carry the generic two-plane consistency semantics: enabled (control plane), traffic_requests and decisions_total (data plane).",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "traffic_requests": {
          "type": "integer",
          "minimum": 0
        },
        "decisions_total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "producer": {
      "type": "object",
      "required": [
        "adapter",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "attestation": {
          "type": "string"
        }
      }
    },
    "signature": {
      "type": "object",
      "description": "Produced by the adapter over the record with this block removed. The same envelope as a conformance statement, deliberately: one signature shape everywhere.",
      "required": [
        "scheme",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "scheme": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "key_id": {
          "type": "string"
        }
      }
    }
  }
}
